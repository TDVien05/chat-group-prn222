<Window x:Class="ChatClient.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ChatClient.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Chat Group"
        Width="1280"
        Height="860"
        MinWidth="1040"
        MinHeight="720"
        Background="{DynamicResource AppWindowBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- ═══════════════════════════════════════════════════════════
             GLOBAL TEXTBOX — flat pill, theme-aware
        ═══════════════════════════════════════════════════════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Margin"          Value="0,5,0,0" />
            <Setter Property="Padding"         Value="12,9" />
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize"        Value="14" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="Foreground"      Value="{DynamicResource TitleBrush}" />
            <Setter Property="CaretBrush"      Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="Background"  Value="{DynamicResource PanelBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             PRIMARY BUTTON
        ═══════════════════════════════════════════════════════════ -->
        <Style TargetType="Button">
            <Setter Property="Margin"          Value="0,5,0,0" />
            <Setter Property="Padding"         Value="16,10" />
            <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="14" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small action button -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding"         Value="12,7" />
            <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Margin"          Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel / danger button -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Padding"         Value="8,5" />
            <Setter Property="Background"      Value="#FA3E3E" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="11" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Margin"          Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar -->
        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height"          Value="5" />
            <Setter Property="Background"      Value="{DynamicResource DividerBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin"          Value="0,4,0,0" />
        </Style>

        <!-- Emoji grid button -->
        <Style x:Key="EmojiButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="44" />
            <Setter Property="Height"          Value="44" />
            <Setter Property="Margin"          Value="3" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily"      Value="Segoe UI Emoji" />
            <Setter Property="FontSize"        Value="22" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular icon button -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="38" />
            <Setter Property="Height"          Value="38" />
            <Setter Property="Margin"          Value="0,0,6,0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="FontFamily"      Value="Segoe UI Emoji" />
            <Setter Property="FontSize"        Value="20" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round blue Send button -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="38" />
            <Setter Property="Height"          Value="38" />
            <Setter Property="Margin"          Value="8,0,0,0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="FontFamily"      Value="Segoe UI Emoji" />
            <Setter Property="FontSize"        Value="17" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.87" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme pill button (inactive state; active state set per-button via DataTrigger) -->
        <Style x:Key="ThemePillStyle" TargetType="Button">
            <Setter Property="Padding"         Value="10,5" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource BodyBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="FontFamily"      Value="Segoe UI Emoji" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Margin"          Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Copy address button — small circular ghost -->
        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="28" />
            <Setter Property="Height"          Value="28" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource AddressBrush}" />
            <Setter Property="FontFamily"      Value="Segoe UI Emoji" />
            <Setter Property="FontSize"        Value="14" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="Margin"          Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT GRID  — sidebar | divider | chat
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource AppWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ╔═══════════════════════════════════════╗
             ║            LEFT SIDEBAR               ║
             ╚═══════════════════════════════════════╝ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sidebar top — title + theme switcher -->
                <Border Padding="20,18,20,14"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe UI"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}">
                            <Run FontFamily="Segoe UI Emoji" Text="💬 " /><Run Text="Chat Group" />
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="{DynamicResource BodyBrush}"
                                   Text="Host a room · share the IP · chat freely" />

                        <!-- ── Theme switcher ── -->
                        <WrapPanel Margin="0,10,0,0">
                            <!-- ☀️ Light -->
                            <Button Content="☀️ Light"
                                    Command="{Binding SetLightThemeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemePillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground"      Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 🌙 Dark -->
                            <Button Content="🌙 Dark"
                                    Command="{Binding SetDarkThemeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemePillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground"      Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 🔷 Midnight -->
                            <Button Content="🔷 Midnight"
                                    Command="{Binding SetMidnightThemeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemePillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMidnightTheme}" Value="True">
                                                <Setter Property="Background"      Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground"      Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Scrollable sidebar body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10,12,16">

                        <!-- ── HOST SERVER ── -->
                        <TextBlock Margin="6,4,0,8"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BodyBrush}"
                                   Text="HOST SERVER" />

                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="12"
                                Padding="16,14"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource BodyBrush}"
                                           Text="Port" />
                                <TextBox Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Content="▶  Start Server"
                                        Command="{Binding StartServerCommand}" />
                                <Button Content="⏹  Stop Server"
                                        Background="{DynamicResource PrimaryDarkBrush}"
                                        Command="{Binding StopServerCommand}" />

                                <Border Margin="0,12,0,10"
                                        Height="1"
                                        Background="{DynamicResource DividerBrush}" />

                                <TextBlock FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BodyBrush}"
                                           Text="Share these addresses" />

                                <!-- Address list — mỗi dòng có nút copy -->
                                <ItemsControl ItemsSource="{Binding HostAddresses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,6,0,0"
                                                    Padding="10,6"
                                                    Background="{DynamicResource SurfaceTintBrush}"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               FontFamily="Consolas"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AddressBrush}"
                                                               Text="{Binding}" />
                                                    <!-- Nút copy địa chỉ -->
                                                    <Button Grid.Column="1"
                                                            x:Name="CopyBtn"
                                                            Content="⎘"
                                                            Style="{StaticResource CopyButtonStyle}"
                                                            ToolTip="Sao chép địa chỉ"
                                                            Click="CopyAddress_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ── JOIN ROOM ── -->
                        <TextBlock Margin="6,20,0,8"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BodyBrush}"
                                   Text="JOIN ROOM" />

                        <Border Background="{DynamicResource CardBrush}"
                                CornerRadius="12"
                                Padding="16,14"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource BodyBrush}" Text="Host IP" />
                                <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,10,0,0" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource BodyBrush}" Text="Port" />
                                <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,10,0,0" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource BodyBrush}" Text="Room" />
                                <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,10,0,0" FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource BodyBrush}" Text="Username" />
                                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Content="🔗  Connect"    Command="{Binding ConnectCommand}" />
                                <Button Content="✕  Disconnect"
                                        Background="{DynamicResource PrimaryDarkBrush}"
                                        Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- ── ACTIVE TRANSFERS (conditional) ── -->
                        <Border Margin="0,16,0,0"
                                Background="{DynamicResource TransferCardBrush}"
                                CornerRadius="12"
                                Padding="16,14"
                                Visibility="{Binding HasActiveTransfers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TransferTextBrush}"
                                           Text="Active Transfers" />

                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ActiveTransfers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:FileTransferItemViewModel}">
                                            <Border Margin="0,0,0,8"
                                                    Padding="12,10"
                                                    Background="{DynamicResource TransferItemBrush}"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Margin="0,0,8,0"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding DirectionIndicator}" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontFamily="Segoe UI"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TransferTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding FileName}" />
                                                        <Button Grid.Column="2"
                                                                Content="✕"
                                                                Style="{StaticResource CancelButtonStyle}"
                                                                Command="{Binding CancelCommand}"
                                                                VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                                                 Value="{Binding Percentage}"
                                                                 Maximum="100" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   FontFamily="Segoe UI"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TransferMetaBrush}"
                                                                   Text="{Binding StatusText}" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontFamily="Segoe UI"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F0}%">
                                                                    <Binding Path="Percentage" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ── SAVED HISTORY ── -->
                        <Border Margin="0,16,0,0"
                                Background="{DynamicResource SurfaceTintBrush}"
                                CornerRadius="12"
                                Padding="16,14"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DeepAccentBrush}">
                                    <Run FontFamily="Segoe UI Emoji" Text="📂 " /><Run Text="Saved History" />
                                </TextBlock>
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="{DynamicResource BodyBrush}"
                                           Text="{Binding HistoryFolder}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Vertical divider -->
        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

        <!-- ╔═══════════════════════════════════════╗
             ║           MAIN CHAT PANEL             ║
             ╚═══════════════════════════════════════╝ -->
        <Border Grid.Column="2" Background="{DynamicResource ChatBgBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── CHAT HEADER ── -->
                <Border Padding="20,14,20,14"
                        Background="{DynamicResource ChatBgBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar circle -->
                        <Border Width="44" Height="44"
                                CornerRadius="22"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="0,0,14,0">
                            <TextBlock FontFamily="Segoe UI Emoji"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="💬" />
                        </Border>

                        <!-- Room info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe UI"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TitleBrush}"
                                       Text="{Binding ActiveRoomTitle}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="{DynamicResource BodyBrush}"
                                       Text="{Binding StatusText}" />
                        </StackPanel>

                        <!-- Connection badge -->
                        <Border Grid.Column="2"
                                Padding="14,7"
                                Background="{DynamicResource SurfaceTintBrush}"
                                CornerRadius="16"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1">
                            <TextBlock FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DeepAccentBrush}"
                                       Text="{Binding ConnectionBadge}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ── MESSAGES LIST ── -->
                <ListBox x:Name="MessagesList"
                         Grid.Row="1"
                         Padding="16,14"
                         Background="{DynamicResource ChatBgBrush}"
                         BorderThickness="0"
                         ItemsSource="{Binding Messages}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"         Value="0" />
                            <Setter Property="Margin"          Value="0,0,0,2" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background"      Value="Transparent" />
                            <Setter Property="Focusable"       Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ChatMessageItemViewModel}">
                            <Grid Margin="0,4,0,4">
                                <Border HorizontalAlignment="{Binding Alignment}"
                                        MaxWidth="520"
                                        Padding="13,10"
                                        Background="{Binding BubbleBrush}"
                                        CornerRadius="18">
                                    <!-- ── Bubble pop-in animation ── -->
                                    <Border.RenderTransformOrigin>0.5,1.0</Border.RenderTransformOrigin>
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                        From="0.82" To="1.0" Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase EasingMode="EaseOut" Amplitude="0.32"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                        From="0.82" To="1.0" Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase EasingMode="EaseOut" Amplitude="0.32"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                        From="14" To="0" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0" To="1" Duration="0:0:0.22" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <StackPanel>

                                        <!-- Sender name — tất cả tin nhắn, kể cả của mình -->
                                        <TextBlock Margin="0,0,0,4"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="{Binding SenderNameAlignment}"
                                                   Text="{Binding User}"
                                                   Visibility="{Binding ShowSender, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <!-- IMAGE message — filename label -->
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding ForegroundBrush}"
                                                   Text="{Binding FileName}"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <!-- IMAGE message — preview -->
                                        <Border Margin="0,6,0,0"
                                                Background="{DynamicResource InputBgBrush}"
                                                CornerRadius="12"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="MessageImage_MouseLeftButtonUp"
                                                Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image MaxWidth="320"
                                                   MaxHeight="240"
                                                   Stretch="Uniform"
                                                   Source="{Binding ImagePreview}" />
                                        </Border>

                                        <!-- FILE READY — download card -->
                                        <Grid Margin="0,2,0,0"
                                              Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock FontFamily="Segoe UI Emoji"
                                                           FontSize="26"
                                                           Text="📄" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontFamily="Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding FileName}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontFamily="Segoe UI"
                                                           FontSize="12"
                                                           Foreground="#A8E8CC"
                                                           Text="{Binding FormattedFileSize}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="↓ Download"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Background="#00A884"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}"
                                                    Click="DownloadFile_Click" />
                                        </Grid>

                                        <!-- FILE PROGRESS -->
                                        <StackPanel Margin="0,2,0,0"
                                                    Visibility="{Binding IsFileProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock FontFamily="Segoe UI"
                                                       FontSize="13"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Body}" />
                                            <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                                         Value="{Binding FileProgress}"
                                                         Maximum="100" />
                                        </StackPanel>

                                        <!-- TEXT / EMOJI message -->
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="Segoe UI Emoji"
                                                   FontSize="{Binding BodyFontSize}"
                                                   Foreground="{Binding ForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Body}"
                                                   Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <!-- Timestamp -->
                                        <TextBlock Margin="0,5,0,0"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   Foreground="{Binding MetaBrush}"
                                                   Text="{Binding TimeLabel}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ── INPUT BAR ── -->
                <Border Grid.Row="2"
                        Background="{DynamicResource ChatBgBrush}"
                        Padding="14,10,14,12"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: icon buttons + emoji picker toggle -->
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Content="🖼️"
                                        ToolTip="Send Image"
                                        Command="{Binding ChooseImageCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Content="📎"
                                        ToolTip="Send File"
                                        Command="{Binding SendFileCommand}" />
                                <!-- Nút mở emoji picker -->
                                <Button x:Name="EmojiPickerBtn"
                                        Style="{StaticResource IconButtonStyle}"
                                        Content="😊"
                                        ToolTip="Chọn emoji"
                                        Command="{Binding ToggleEmojiPickerCommand}" />
                            </StackPanel>

                            <!-- Emoji picker popup -->
                            <Popup IsOpen="{Binding IsEmojiPickerOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Placement="Top"
                                   VerticalOffset="-8"
                                   PlacementTarget="{Binding ElementName=EmojiPickerBtn}">
                                <Border Background="{DynamicResource PanelBrush}"
                                        CornerRadius="16"
                                        Padding="12"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20"
                                                          ShadowDepth="4"
                                                          Opacity="0.18"
                                                          Color="Black" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Margin="4,0,0,8"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BodyBrush}"
                                                   Text="😊  Biểu cảm" />
                                        <ItemsControl ItemsSource="{Binding Emojis}" Width="270">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type viewModels:EmojiItemViewModel}">
                                                    <Button Content="{Binding Glyph}"
                                                            Background="{Binding ButtonBackground}"
                                                            Command="{Binding Command}"
                                                            Style="{StaticResource EmojiButtonStyle}"
                                                            ToolTip="{Binding Name}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Row 1: image preview panel -->
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Padding="14,12"
                                Background="{DynamicResource InputBgBrush}"
                                CornerRadius="12"
                                Visibility="{Binding HasPendingImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10">
                                    <Image MaxWidth="160"
                                           MaxHeight="120"
                                           Stretch="Uniform"
                                           Source="{Binding SelectedImagePreview}" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TitleBrush}"
                                               Text="Image preview" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               Foreground="{DynamicResource BodyBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedImageFileName}" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Width="116" Content="↑ Send Image" Command="{Binding SendImageCommand}" />
                                        <Button Width="90"
                                                Margin="8,0,0,0"
                                                Background="#FA3E3E"
                                                Content="Remove"
                                                Command="{Binding ClearSelectedImageCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 2: text input + send -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Pill text input + placeholder -->
                            <Border Background="{DynamicResource InputBgBrush}"
                                    CornerRadius="20"
                                    Padding="16,6">
                                <Grid>
                                    <!-- Placeholder — ẩn khi có chữ -->
                                    <TextBlock IsHitTestVisible="False"
                                               Text="Type something..."
                                               FontSize="14"
                                               FontFamily="Segoe UI"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource BodyBrush}"
                                               VerticalAlignment="Center"
                                               Opacity="0.5"
                                               Visibility="{Binding IsOutgoingMessageEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox AcceptsReturn="True"
                                             MinHeight="30"
                                             MaxHeight="100"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="0"
                                             Padding="0"
                                             FontSize="14"
                                             FontFamily="Segoe UI"
                                             VerticalAlignment="Center"
                                             Text="{Binding OutgoingMessage, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>

                            <!-- Round Send button -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource SendButtonStyle}"
                                    Content="➤"
                                    Command="{Binding SendMessageCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── CONNECTION LOST DIALOG OVERLAY ── -->
                <Border Grid.RowSpan="3"
                        Background="#B0000000"
                        Visibility="{Binding IsConnectionLostDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PanelBrush}"
                            CornerRadius="20"
                            Padding="36,30"
                            Width="400">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                        <Border.RenderTransformOrigin>0.5,0</Border.RenderTransformOrigin>
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="-24" To="0" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <Border Width="72" Height="72"
                                    CornerRadius="36"
                                    Background="#FFF3E0"
                                    HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe UI Emoji"
                                           FontSize="36"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="🔌" />
                            </Border>

                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe UI"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TitleBrush}"
                                       Text="Kết nối bị ngắt" />

                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       Foreground="{DynamicResource BodyBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{Binding ConnectionLostReason}" />

                            <Border Margin="0,16,0,0"
                                    Padding="14,9"
                                    Background="{DynamicResource SurfaceTintBrush}"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Text="{Binding LastConnectionInfo}" />
                            </Border>

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="✕   Đóng"
                                        Background="{DynamicResource BodyBrush}"
                                        Margin="0"
                                        Command="{Binding DismissConnectionLostCommand}" />
                                <Button Grid.Column="2"
                                        Content="🔄  Kết nối lại"
                                        Background="{DynamicResource PrimaryBrush}"
                                        Margin="0"
                                        Command="{Binding ReconnectCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- ── IMAGE VIEWER OVERLAY ── -->
                <Border Grid.RowSpan="3"
                        Background="#CC000000"
                        Visibility="{Binding IsImageViewerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="24,20,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe UI"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ViewerImageFileName}" />
                            <Button Grid.Column="1"
                                    Width="88"
                                    Content="✕  Close"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Click="CloseImageViewer_Click" />
                        </Grid>

                        <Viewbox Grid.Row="1" Margin="24" Stretch="Uniform">
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="10">
                                <Image Stretch="Uniform" Source="{Binding ViewerImageSource}" />
                            </Border>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

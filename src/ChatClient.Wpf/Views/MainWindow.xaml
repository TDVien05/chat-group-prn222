<Window x:Class="ChatClient.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ChatClient.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Chat Group Host"
        Width="1240"
        Height="820"
        MinWidth="1000"
        MinHeight="700"
        Background="#EAF6FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="AppWindowBrush" Color="#EAF6FF" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F7FBFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#DDF0FF" />
        <SolidColorBrush x:Key="CardAccentBrush" Color="#C8E7FF" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#B6D9F4" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3296E6" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E6FB5" />
        <SolidColorBrush x:Key="DeepAccentBrush" Color="#0F4C81" />
        <SolidColorBrush x:Key="SurfaceTintBrush" Color="#EEF8FF" />
        <SolidColorBrush x:Key="TitleBrush" Color="#123E66" />
        <SolidColorBrush x:Key="BodyBrush" Color="#51718D" />
        <SolidColorBrush x:Key="AddressBrush" Color="#1C5A8F" />

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="24" Background="{StaticResource PanelBrush}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Chat Group" FontFamily="Georgia" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock Text="Host a room, share the IP, then join like a regular messenger."
                               Margin="0,8,0,18"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BodyBrush}" />

                    <Border Background="{StaticResource CardBrush}" CornerRadius="18" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Host Server" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                            <TextBlock Text="Port" Margin="0,12,0,0" Foreground="{StaticResource BodyBrush}" />
                            <TextBox Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Start Server" Command="{Binding StartServerCommand}" />
                            <Button Content="Stop Server" Background="{StaticResource PrimaryDarkBrush}" Command="{Binding StopServerCommand}" />
                            <TextBlock Margin="0,14,0,0" Text="Share these addresses" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                            <ItemsControl ItemsSource="{Binding HostAddresses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,0" Padding="10,8" Background="{StaticResource SurfaceTintBrush}" CornerRadius="12">
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="{StaticResource AddressBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0" Background="{StaticResource CardBrush}" CornerRadius="18" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Join Room" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                            <TextBlock Text="Host IP" Margin="0,12,0,0" Foreground="{StaticResource BodyBrush}" />
                            <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Port" Margin="0,12,0,0" Foreground="{StaticResource BodyBrush}" />
                            <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Room" Margin="0,12,0,0" Foreground="{StaticResource BodyBrush}" />
                            <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="User name" Margin="0,12,0,0" Foreground="{StaticResource BodyBrush}" />
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Connect" Command="{Binding ConnectCommand}" />
                            <Button Content="Disconnect" Background="{StaticResource PrimaryDarkBrush}" Command="{Binding DisconnectCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0" Background="{StaticResource DeepAccentBrush}" CornerRadius="18" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Saved history" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding HistoryFolder}" TextWrapping="Wrap" Foreground="#D7EDFF" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="28" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource CardAccentBrush}" CornerRadius="28,28,0,0" Padding="24,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveRoomTitle}" FontFamily="Georgia" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding StatusText}" Foreground="{StaticResource BodyBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="14,10" Background="#F4FBFF" CornerRadius="14">
                            <TextBlock Text="{Binding ConnectionBadge}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <ListBox x:Name="MessagesList"
                         Grid.Row="1"
                         Margin="18"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Messages}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,14" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ChatMessageItemViewModel}">
                            <Grid>
                                <Border HorizontalAlignment="{Binding Alignment}"
                                        MaxWidth="480"
                                        Padding="16,12"
                                        Background="{Binding BubbleBrush}"
                                        CornerRadius="20">
                                    <StackPanel>
                                        <TextBlock Text="{Binding User}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C6FA4"
                                                   Visibility="{Binding ShowSender, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding FileName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding ForegroundBrush}"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Margin="0,8,0,0"
                                                Background="#F7FBFF"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="MessageImage_MouseLeftButtonUp"
                                                Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{Binding ImagePreview}"
                                                   MaxWidth="320"
                                                   MaxHeight="240"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Body}"
                                                   FontSize="15"
                                                   FontFamily="Segoe UI Emoji"
                                                   Foreground="{Binding ForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding TimeLabel}" FontSize="11" Foreground="{Binding MetaBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#EEF8FF" CornerRadius="0,0,28,28" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel>
                            <Button Width="48" Height="44" Margin="0,0,8,0" FontFamily="Segoe UI Emoji" Content="&#x1F44D;" Command="{Binding SendThumbsUpCommand}" />
                            <Button Width="48" Height="44" Margin="0,0,8,0" FontFamily="Segoe UI Emoji" Content="&#x2764;&#xFE0F;" Command="{Binding SendHeartCommand}" />
                            <Button Width="48" Height="44" Margin="0,0,8,0" FontFamily="Segoe UI Emoji" Content="&#x1F602;" Command="{Binding SendLaughCommand}" />
                            <Button Width="48" Height="44" FontFamily="Segoe UI Emoji" Content="&#x1F62E;" Command="{Binding SendSurprisedCommand}" />
                            <Button Margin="12,0,0,0" Content="Choose Image" Command="{Binding ChooseImageCommand}" />
                        </WrapPanel>

                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="14"
                                Background="#DDF0FF"
                                CornerRadius="18"
                                Visibility="{Binding HasPendingImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F7FBFF" CornerRadius="14">
                                    <Image Source="{Binding SelectedImagePreview}"
                                           MaxWidth="180"
                                           MaxHeight="140"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Image preview"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleBrush}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding SelectedImageFileName}"
                                               Foreground="{StaticResource BodyBrush}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Width="120" Content="Send Image" Command="{Binding SendImageCommand}" />
                                        <Button Width="120"
                                                Margin="10,6,0,0"
                                                Background="{StaticResource PrimaryDarkBrush}"
                                                Content="Remove"
                                                Command="{Binding ClearSelectedImageCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox AcceptsReturn="True"
                                     MinHeight="60"
                                     MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Text="{Binding OutgoingMessage, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Send" Command="{Binding SendMessageCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.RowSpan="3"
                        Background="#DD08131F"
                        Visibility="{Binding IsImageViewerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="24,20,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ViewerImageFileName}"
                                       VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Width="88"
                                    Content="Close"
                                    Background="#2A5F96"
                                    Click="CloseImageViewer_Click" />
                        </Grid>

                        <Viewbox Grid.Row="1" Margin="24" Stretch="Uniform">
                            <Border Background="#F7FBFF" CornerRadius="20" Padding="12">
                                <Image Source="{Binding ViewerImageSource}" Stretch="Uniform" />
                            </Border>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

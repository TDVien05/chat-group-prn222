<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Midnight — lấy cảm hứng từ Telegram Dark ════════════════ -->
    <!--   Deep navy background · teal-blue bubbles · steel-blue text  -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppWindowBrush"        Color="#17212B" />
    <SolidColorBrush x:Key="SidebarBgBrush"        Color="#0E1621" />
    <SolidColorBrush x:Key="ChatBgBrush"           Color="#0F1923" />
    <SolidColorBrush x:Key="PanelBrush"            Color="#17212B" />
    <SolidColorBrush x:Key="CardBrush"             Color="#1E2D3E" />
    <SolidColorBrush x:Key="InputBgBrush"          Color="#192736" />
    <SolidColorBrush x:Key="InputBorderBrush"      Color="#3A5B7A" />

    <!-- Brand / accent -->
    <SolidColorBrush x:Key="PrimaryBrush"          Color="#5EADF7" />
    <SolidColorBrush x:Key="PrimaryDarkBrush"      Color="#3A8AE8" />
    <SolidColorBrush x:Key="DeepAccentBrush"       Color="#5EADF7" />
    <SolidColorBrush x:Key="SurfaceTintBrush"      Color="#1A3352" />
    <SolidColorBrush x:Key="SurfaceBorderBrush"    Color="#2D5A8C" />

    <!-- Text -->
    <SolidColorBrush x:Key="TitleBrush"            Color="#FFFFFF" />
    <SolidColorBrush x:Key="BodyBrush"             Color="#8B9DA8" />
    <SolidColorBrush x:Key="AddressBrush"          Color="#5EADF7" />

    <!-- Structural -->
    <SolidColorBrush x:Key="DividerBrush"          Color="#253340" />
    <SolidColorBrush x:Key="HoverBrush"            Color="#253340" />

    <!-- Chat bubbles — Telegram-style own = navy, incoming = dark navy -->
    <SolidColorBrush x:Key="OwnBubbleBrush"        Color="#2B5278" />
    <SolidColorBrush x:Key="IncomingBubbleBrush"   Color="#182533" />
    <SolidColorBrush x:Key="SystemBubbleBrush"     Color="#1A3355" />
    <SolidColorBrush x:Key="OwnBubbleForeground"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="IncomingBubbleForeground" Color="#DDEEFF" />
    <SolidColorBrush x:Key="MetaForeground"        Color="#607080" />

    <!-- File-transfer panel -->
    <SolidColorBrush x:Key="TransferCardBrush"     Color="#1C2733" />
    <SolidColorBrush x:Key="TransferItemBrush"     Color="#243347" />
    <SolidColorBrush x:Key="TransferTextBrush"     Color="#E4E6EB" />
    <SolidColorBrush x:Key="TransferMetaBrush"     Color="#6A7B8A" />

</ResourceDictionary>
